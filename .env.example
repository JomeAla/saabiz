# ===============================================
# SAABIZ Environment Variables
# ===============================================
# Copy this file to .env and fill in the values
# DO NOT commit .env to version control!
#
# This project runs NATIVELY (no Docker):
#   - PostgreSQL installed locally (default port 5432)
#   - Redis via Memurai service (default port 6379)
#   - API served by `nx serve api`  (port 3001)
#   - Web served by `nx serve web`  (port 3000)
# ===============================================

# Database (native PostgreSQL)
DATABASE_URL="postgresql://postgres:your-password-here@127.0.0.1:5432/saabiz?schema=public"

# Redis (Memurai on Windows / redis-server on Linux, no password by default)
REDIS_URL="redis://localhost:6379"

# API
PORT=3001
# Generate with: openssl rand -base64 48
JWT_SECRET=generate-a-secure-random-string-here
JWT_EXPIRES_IN=7d

# Web
NEXT_PUBLIC_API_URL=http://localhost:3001
FRONTEND_URL=http://localhost:3000
WEB_PORT=3000

# Multi-domain platform (root domain of the marketplace)
PLATFORM_DOMAIN=saabiz.com

# CORS: platform origins + wildcard tenant subdomains.
# Tenant (custom) domains are added dynamically from the database.
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,https://saabiz.com,https://www.saabiz.com,https://*.saabiz.com

# Environment
NODE_ENV=development
LOG_LEVEL=info
LOG_DIR=./logs

# ===============================================
# Email Configuration
# ===============================================
# Development: Leave empty to use Ethereal (fake SMTP)
# Production: Use SendGrid, Resend, AWS SES, or any SMTP provider
# ===============================================

SMTP_HOST=smtp.ethereal.email
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM="SAABIZ <noreply@saabiz.com>"

# SendGrid (uncomment and fill in for production)
# SMTP_HOST=smtp.sendgrid.net
# SMTP_PORT=587
# SMTP_USER=apikey
# SMTP_PASS=your_sendgrid_api_key

# Resend (uncomment and fill in for production)
# SMTP_HOST=smtp.resend.com
# SMTP_PORT=587
# SMTP_USER=resend
# SMTP_PASS=re_your_resend_api_key

# ===============================================
# Rate Limiting
# ===============================================
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100

# ===============================================
# Optional: Error Tracking (Sentry)
# ===============================================
# SENTRY_DSN=https://xxxxx@sentry.io/xxxxx