{
  "name": "saabiz",
  "version": "1.0.0",
  "private": true,
  "description": "SAABIZ - Merchant of Record & Software Monetization Platform",
  "scripts": {
    "build": "nx build",
    "build:api": "nx build api",
    "build:web": "nx build web",
    "dev:all": "concurrently \"pnpm run dev:api\" \"pnpm run dev:web\"",
    "dev:api": "nx serve api",
    "dev:web": "nx serve web",
    "serve": "nx serve",
    "serve:all": "nx run-many --target=serve --parallel",
    "lint": "nx lint",
    "typecheck": "nx run-many --target=typecheck",
    "prisma:generate": "prisma generate --schema=libs/prisma/schema/schema.prisma",
    "prisma:migrate": "prisma migrate dev --schema=libs/prisma/schema/schema.prisma",
    "prisma:migrate:deploy": "prisma migrate deploy --schema=libs/prisma/schema/schema.prisma",
    "prisma:push": "prisma db push --schema=libs/prisma/schema/schema.prisma",
    "prisma:seed": "ts-node prisma/seed.ts",
    "test:e2e": "playwright test",
    "test:e2e:storefront": "playwright test storefront.spec.ts",
    "backup:db": "powershell -ExecutionPolicy Bypass -File scripts/backup-db.ps1",
    "monitor": "powershell -ExecutionPolicy Bypass -File scripts/monitor.ps1"
  },
  "prisma": {
    "schema": "libs/prisma/schema/schema.prisma",
    "seed": "ts-node prisma/seed.ts"
  },
  "dependencies": {
    "@nestjs/common": "^10.4.22",
    "@nestjs/core": "^10.4.22",
    "@nestjs/event-emitter": "^2.0.0",
    "@nestjs/jwt": "^10.0.0",
    "@nestjs/passport": "^10.0.0",
    "@nestjs/platform-express": "^10.4.22",
    "@nestjs/schedule": "latest",
    "@nestjs/swagger": "^7.0.0",
    "@phosphor-icons/react": "^2.1.10",
    "@prisma/client": "^5.0.0",
    "@sentry/node": "^7.0.0",
    "@types/nodemailer": "^7.0.11",
    "autoprefixer": "^10.4.27",
    "axios": "^1.6.0",
    "bcryptjs": "^3.0.3",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.14.0",
    "clsx": "^2.1.1",
    "express-rate-limit": "^7.0.0",
    "framer-motion": "^11.0.0",
    "helmet": "^7.0.0",
    "ioredis": "^5.3.0",
    "lucide-react": "^0.576.0",
    "next": "14.2.3",
    "nodemailer": "^8.0.3",
    "passport": "^0.6.0",
    "passport-jwt": "^4.0.1",
    "pdfkit": "^0.15.0",
    "postcss": "^8.5.8",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "reflect-metadata": "^0.1.13",
    "rxjs": "^7.8.0",
    "stripe": "^20.4.0",
    "tailwind-merge": "^3.5.0",
    "tailwindcss": "^3.4.0",
    "tslib": "^2.3.0",
    "winston": "^3.11.0",
    "winston-daily-rotate-file": "^4.7.1"
  },
  "devDependencies": {
    "@nestjs/schematics": "^10.0.0",
    "@nestjs/testing": "^10.0.0",
    "@nx/js": "20.4.6",
    "@nx/nest": "20.4.6",
    "@nx/next": "20.4.6",
    "@nx/node": "20.4.6",
    "@nx/workspace": "20.4.6",
    "@playwright/test": "^1.49.0",
    "@types/express-rate-limit": "^5.0.0",
    "@types/node": "18.16.9",
    "@types/passport-jwt": "^3.0.8",
    "@types/react": "18.3.1",
    "@types/react-dom": "18.3.1",
    "@types/yargs": "^17.0.0",
    "concurrently": "^8.2.2",
    "nx": "20.4.6",
    "prisma": "^5.0.0",
    "typescript": "~5.5.2"
  },
  "engines": {
    "node": ">=20",
    "pnpm": ">=10"
  },
  "packageManager": "pnpm@10.33.0"
}