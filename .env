# ===============================================
# SAABIZ Environment (native, no Docker)
# ===============================================

# Database (native PostgreSQL on port 5432)
DATABASE_URL="postgresql://postgres:postgres@127.0.0.1:5432/saabiz?schema=public"

# Redis (Memurai service on localhost:6379)
REDIS_URL="redis://localhost:6379"

# API
PORT=3001
JWT_SECRET="SAABIZ_JWT_SECRET_2026_KEY"
JWT_EXPIRES_IN=7d

# Web
NEXT_PUBLIC_API_URL=http://localhost:3001
FRONTEND_URL=http://localhost:3000
WEB_PORT=3000

# Multi-domain platform
PLATFORM_DOMAIN=saabiz.com

# CORS: platform origins + wildcard tenant subdomains (tenant domains are added dynamically from DB)
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,https://saabiz.com,https://www.saabiz.com,https://*.saabiz.com

# Environment
NODE_ENV=development
LOG_LEVEL=info
LOG_DIR=./logs

# Rate Limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100

# Email Configuration
# Development: Uses Ethereal.email (fake SMTP for testing)
# Production: Replace with SendGrid, Resend, AWS SES, or any SMTP provider
SMTP_HOST=smtp.ethereal.email
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM="SAABIZ <noreply@saabiz.com>"

# Optional: Error Tracking (Sentry)
# SENTRY_DSN=https://xxxxx@sentry.io/xxxxx