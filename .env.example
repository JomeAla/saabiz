# ===============================================
# SAABIZ Environment Variables
# ===============================================
# Copy this file to .env and fill in the values
# DO NOT commit .env to version control!
# ===============================================

# Database
POSTGRES_USER=postgres
POSTGRES_PASSWORD=changeme
POSTGRES_DB=saabiz
POSTGRES_PORT=5434

# Redis
REDIS_PASSWORD=
REDIS_PORT=6380

# API
PORT=3001
API_PORT=3001
JWT_SECRET=generate-a-secure-random-string-here
JWT_EXPIRES_IN=7d

# URLs
NEXT_PUBLIC_API_URL=http://localhost:3001
FRONTEND_URL=http://localhost:3000

# CORS
CORS_ORIGINS=http://localhost:3000,https://yourdomain.com

# Environment
NODE_ENV=development

# Web
WEB_PORT=3000

# Nginx
NGINX_PORT=80

# ===============================================
# Email Configuration
# ===============================================
# Development: Leave empty to use Ethereal (fake SMTP)
# Production: Use SendGrid, Resend, AWS SES, or any SMTP provider
# ===============================================

SMTP_HOST=smtp.ethereal.email
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM="SAABIZ" <noreply@saabiz.com>

# SendGrid (uncomment and fill in for production)
# SMTP_HOST=smtp.sendgrid.net
# SMTP_PORT=587
# SMTP_USER=apikey
# SMTP_PASS=your_sendgrid_api_key

# Resend (uncomment and fill in for production)
# SMTP_HOST=smtp.resend.com
# SMTP_PORT=587
# SMTP_USER=resend
# SMTP_PASS=re_your_resend_api_key

# ===============================================
# Logging
# ===============================================
LOG_LEVEL=info
LOG_DIR=./logs

# ===============================================
# Rate Limiting
# ===============================================
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100

# ===============================================
# Optional: Error Tracking (Sentry)
# ===============================================
# SENTRY_DSN=https://xxxxx@sentry.io/xxxxx
