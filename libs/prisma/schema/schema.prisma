// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id        String   @id @default(uuid())
  email     String   @unique
  password  String
  role      Role     @default(SELLER)
  isEmailVerified Boolean @default(false)
  emailVerifyToken String?
  passwordResetToken String?
  passwordResetExpires DateTime?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  seller    Seller?
  affiliate Affiliate?
}

model Tenant {
  id        String   @id @default(uuid())
  name      String
  slug      String   @unique
  isActive  Boolean  @default(true)
  settings  Json? // branding: logoUrl, primaryColor, tagline, currency
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  seller    Seller?
  domains   Domain[]
  configs   PlatformConfig[]
}

model Domain {
  id         String   @id @default(uuid())
  host       String   @unique // normalized: lowercase, no protocol or port
  tenantId   String
  tenant     Tenant   @relation(fields: [tenantId], references: [id])
  isPrimary  Boolean  @default(false)
  isVerified Boolean  @default(true)
  createdAt  DateTime @default(now())
}

model Seller {
  id            String    @id @default(uuid())
  userId        String    @unique
  user          User      @relation(fields: [userId], references: [id])
  tenantId      String?   @unique
  tenant        Tenant?   @relation(fields: [tenantId], references: [id])
  businessName  String?
  payoutEmail   String?
  payoutGateway String?
  totalEarnings Float     @default(0)
  pendingPayout Float     @default(0)
  products      Product[]
}

model Affiliate {
  id              String    @id @default(uuid())
  userId          String    @unique
  user            User      @relation(fields: [userId], references: [id])
  affiliateCode   String    @unique
  commissionRate  Float     @default(0.1)
  totalEarnings   Float     @default(0)
  pendingPayout   Float     @default(0)
  totalReferrals  Int       @default(0)
  totalCommission Float     @default(0)
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
  links           AffiliateLink[]
  commissions     AffiliateCommission[]
  payouts         AffiliatePayout[]
}

model AffiliateLink {
  id          String    @id @default(uuid())
  affiliateId String
  affiliate   Affiliate @relation(fields: [affiliateId], references: [id])
  productId   String
  product     Product   @relation(fields: [productId], references: [id])
  code        String    @unique
  clicks      Int       @default(0)
  conversions Int       @default(0)
  createdAt   DateTime  @default(now())
  isActive    Boolean   @default(true)

  @@unique([affiliateId, productId])
}

model AffiliateCommission {
  id            String        @id @default(uuid())
  affiliateId   String
  affiliate     Affiliate     @relation(fields: [affiliateId], references: [id])
  transactionId String?      @unique
  transaction   Transaction?  @relation(fields: [transactionId], references: [id])
  productId     String
  product       Product       @relation(fields: [productId], references: [id])
  amount        Float
  currency      String        @default("USD")
  status        CommissionStatus @default(PENDING)
  createdAt     DateTime      @default(now())
  paidAt        DateTime?
}

model AffiliatePayout {
  id           String   @id @default(uuid())
  affiliateId  String
  affiliate    Affiliate @relation(fields: [affiliateId], references: [id])
  amount       Float
  currency     String   @default("USD")
  status       PayoutStatus @default(PENDING)
  reference    String?  @unique
  createdAt    DateTime @default(now())
  processedAt  DateTime?
}

enum CommissionStatus {
  PENDING
  APPROVED
  PAID
  CANCELLED
}

enum PayoutStatus {
  PENDING
  PROCESSING
  COMPLETED
  FAILED
}

model PlatformConfig {
  id                   String   @id @default(uuid())
  tenantId             String?  @unique // null = platform-level config (fallback for tenants)
  tenant               Tenant?  @relation(fields: [tenantId], references: [id])
  paystackPublicKey    String?
  paystackSecretKey    String?
  paystackActive       Boolean  @default(false)
  flutterwavePublicKey  String?
  flutterwaveSecretKey  String?
  flutterwaveEncryptionKey String?
  flutterwaveActive     Boolean  @default(false)
  webhookSecret        String?
  updatedAt            DateTime @updatedAt
}

model Product {
  id          String   @id @default(uuid())
  sellerId    String
  seller      Seller   @relation(fields: [sellerId], references: [id])
  name        String
  description String?
  isFrozen    Boolean  @default(false)
  freezeReason String?
  downloadUrl String?
  version     String?
  plans       Plan[]
  licenses    License[]
  transactions Transaction[]
  subscriptions Subscription[]
  affiliateLinks AffiliateLink[]
  commissions     AffiliateCommission[]
  honeypots      Honeypot[]
}

model Transaction {
  id          String    @id @default(uuid())
  productId   String
  product     Product   @relation(fields: [productId], references: [id])
  planId      String
  plan        Plan      @relation(fields: [planId], references: [id])
  reference   String    @unique
  gateway     String
  amount      Float
  currency    String    @default("USD")
  status      String
  buyerEmail  String?
  platformFee Float     @default(0)
  sellerEarnings Float  @default(0)
  affiliateId   String?
  subscriptionId String?
  subscription Subscription? @relation(fields: [subscriptionId], references: [id])
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  license     License?
  affiliateCommission AffiliateCommission?
  promotionId String?
  promotion   Promotion? @relation(fields: [promotionId], references: [id])
}

model Plan {
  id             String   @id @default(uuid())
  productId      String
  product        Product  @relation(fields: [productId], references: [id])
  name           String
  price          Float
  interval       Interval @default(ONETIME)
  isDefault      Boolean  @default(false)
  maxActivations Int      @default(1)  // 1 = single site, 2+ = multi-site, 0 = unlimited
  transactions   Transaction[]
  subscriptions  Subscription[]
}

model Subscription {
  id          String    @id @default(uuid())
  customerEmail String
  productId   String
  product     Product   @relation(fields: [productId], references: [id])
  planId      String
  plan        Plan      @relation(fields: [planId], references: [id])
  gateway     String
  gatewaySubscriptionId String?
  status         SubscriptionStatus @default(ACTIVE)
  currentPeriodStart DateTime
  currentPeriodEnd   DateTime
  cancelAtPeriodEnd  Boolean @default(false)
  paymentFailedAt DateTime?
  graceUntil DateTime?
  lastDunningSentAt DateTime?
  createdAt      DateTime    @default(now())
  updatedAt      DateTime    @updatedAt
  licenses       License[]
  transactions   Transaction[]
}

enum SubscriptionStatus {
  ACTIVE
  CANCELED
  PAST_DUE
  TRIALING
  IN_GRACE_PERIOD
}

model License {
  id             String   @id @default(uuid())
  productId      String
  product        Product  @relation(fields: [productId], references: [id])
  key            String   @unique
  active         Boolean  @default(true)
  expiresAt      DateTime?
  buyerEmail     String?
  transactionId  String?  @unique
  transaction    Transaction? @relation(fields: [transactionId], references: [id])
  subscriptionId String?
  subscription   Subscription? @relation(fields: [subscriptionId], references: [id])
  machineId      String?  // Current activated machine ID
  activations    Int      @default(0)  // Number of times activated (for tracking)
}

model AuditLog {
  id          String   @id @default(uuid())
  userId      String?
  userEmail   String?
  action      String
  resource    String?
  resourceId  String?
  details     Json?
  ipAddress   String?
  userAgent   String?
  status      String   @default("success")
  createdAt   DateTime @default(now())
}

// Decoy license keys planted by admins/sellers. Any use of these keys on the
// public license endpoints is recorded as a HoneypotHit and alerts the seller.
model Honeypot {
  id        String        @id @default(uuid())
  productId String
  product   Product       @relation(fields: [productId], references: [id])
  key       String        @unique
  label     String? // where the decoy was planted (leaked build, forum, etc.)
  isActive  Boolean       @default(true)
  createdAt DateTime      @default(now())
  hits      HoneypotHit[]

  @@index([productId])
}

model HoneypotHit {
  id         String   @id @default(uuid())
  honeypotId String
  honeypot   Honeypot @relation(fields: [honeypotId], references: [id])
  endpoint   String // verify | ota-check | ota-validate | activate | deactivate | status
  machineId  String?
  domain     String?
  ipAddress  String?
  userAgent  String?
  metadata   Json?
  createdAt  DateTime @default(now())

  @@index([honeypotId, createdAt])
}

// Bots that fill the invisible honeypot field on public forms (register,
// forgot-password). The submission is silently dropped and recorded here.
model BotSubmission {
  id        String   @id @default(uuid())
  form      String // register | register-customer | forgot-password
  email     String?
  ipAddress String?
  userAgent String?
  metadata  Json?
  createdAt DateTime @default(now())

  @@index([createdAt])
}

// Every payment webhook received from a gateway. Kept for auditing and so
// admins can replay an event after fixing config/data issues.
model WebhookEvent {
  id               String   @id @default(uuid())
  gateway          String // paystack | flutterwave
  eventName        String
  reference        String?
  signature        String? // stored: required to replay authenticated requests
  rawBody          String? // paystack signs the raw body — needed for replay
  payload          Json
  status           String   @default("processing") // processing | processed | duplicate | ignored | failed
  error            String?
  configId         String? // which PlatformConfig matched the signature
  replayCount      Int      @default(0)
  lastReplayAt     DateTime?
  lastReplayStatus String?
  createdAt        DateTime @default(now())

  @@index([gateway, createdAt])
}

enum Role {
  ADMIN
  SELLER
  CUSTOMER
  AFFILIATE
}

enum Interval {
  ONETIME
  MONTHLY
  ANNUAL
}

model Promotion {
  id          String   @id @default(uuid())
  code        String   @unique
  description String?
  discountType DiscountType @default(PERCENTAGE)
  discountValue Float
  startDate   DateTime
  endDate     DateTime?
  isActive    Boolean  @default(true)
  maxUses     Int?
  uses        Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  transactions Transaction[]
}

enum DiscountType {
  PERCENTAGE
  FIXED
}
